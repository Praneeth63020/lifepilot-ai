# ─────────────────────────────────────────────────────────────
# LifePilot AI — environment configuration
# Copy to .env and fill in. Placeholder values only — never commit real secrets.
# The API and worker validate this file at startup and refuse to start
# with a clear message if required values are missing or malformed.
# ─────────────────────────────────────────────────────────────

# Runtime: development | test | production
NODE_ENV=development
LOG_LEVEL=info

# ── Core infrastructure (required) ──
DATABASE_URL=postgresql://lifepilot:lifepilot@localhost:5432/lifepilot
REDIS_URL=redis://localhost:6379

# ── URLs ──
API_PORT=4000
# Number of reverse proxies in front of the API (default: 1 in production, 0 otherwise).
# Used for client IPs in rate limiting. Railway edge + web nginx = 2.
# TRUST_PROXY_HOPS=1
# Public URL of the API (used to build OAuth redirect URIs)
API_URL=http://localhost:4000
# Public URL of the web app (CORS allow-list origin + post-OAuth redirects)
WEB_URL=http://localhost:5173
# Reserved for the phase-2 mobile app deep links
MOBILE_DEEP_LINK_SCHEME=lifepilot

# ── Secrets (required) ──
# 32+ random chars. Generate: openssl rand -base64 48
SESSION_SECRET=replace-with-at-least-32-random-characters
# 32-byte key, base64. Encrypts stored Google OAuth tokens (AES-256-GCM).
# Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# ── Demo mode ──
# true: new accounts get synthetic emails + calendar events, a persistent
# "Demo mode" banner is shown, and nothing pretends to be a real Google account.
DEMO_MODE=true

# ── AI (optional) ──
# AI_PROVIDER=mock uses the deterministic rule-based extractor (no network, no cost).
# AI_PROVIDER=openai requires OPENAI_API_KEY. Falls back to mock on any failure.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_TIMEOUT_MS=15000

# ── Google OAuth (optional — enables real Gmail / Calendar) ──
# Create at https://console.cloud.google.com/apis/credentials (type: Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" in the Google console
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/integrations/google/callback
# Minimum scopes. gmail.readonly is a RESTRICTED scope (see docs/security.md).
GOOGLE_GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.readonly
GOOGLE_CALENDAR_SCOPES=https://www.googleapis.com/auth/calendar.readonly
GMAIL_SYNC_WINDOW_DAYS=14
CALENDAR_SYNC_WINDOW_DAYS=30

# ── Web push (optional) ──
# Generate: pnpm --filter @lifepilot/core exec web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ── Automated email: verification, password reset, password-changed notices ──
# Any standard SMTP provider (setup guide: docs/setup.md#email). Required in production.
#   Resend (TLS):        SMTP_URL=smtps://resend:<API key>@smtp.resend.com:465
#   Any provider (STARTTLS): SMTP_URL=smtp://<user>:<password>@<host>:587
#   Local test inbox:    SMTP_URL=smtp://localhost:1025   (Mailpit, see docker-compose.yml)
# Leave empty in development to send nothing: the Forgot password page and Settings > Security
# then show the link directly when you use the app on this machine. Check with: pnpm mail:check
# Percent-encode special characters in the password (e.g. @ → %40).
SMTP_URL=
# Sender of automated emails, on your verified sending domain.
MAIL_FROM="LifePilot AI <no-reply@example.com>"
# Where customer replies go. Defaults to SUPPORT_EMAIL.
MAIL_REPLY_TO=

# ── Customer support ──
# Public support mailbox shown on the website (footer, /support), in the app (Help & support) and
# in every email. Leave empty to show "coming soon"; nothing is ever invented.
SUPPORT_EMAIL=
# Optional reply-time promise shown next to the address, e.g. "within 2 business days".
SUPPORT_RESPONSE_TIME=
