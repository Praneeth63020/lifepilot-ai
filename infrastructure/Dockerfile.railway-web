# Railway web service. Build from the repository root.
FROM node:22-bookworm-slim AS build
RUN corepack enable
WORKDIR /repo
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @lifepilot/web build

FROM nginx:1.27-alpine AS runtime
# Only substitute our own template variable; preserve nginx variables such as $uri and $host.
ENV NGINX_ENVSUBST_FILTER=^API_UPSTREAM$ API_UPSTREAM=api.railway.internal:4000
COPY infrastructure/nginx.railway.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /repo/apps/web/dist /usr/share/nginx/html
EXPOSE 8080
