# Railway background-worker service. Build from the repository root.
FROM node:22-bookworm-slim AS build
RUN corepack enable
WORKDIR /repo
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @lifepilot/worker build
RUN pnpm --filter @lifepilot/worker deploy --prod --legacy --config.node-linker=hoisted /out/worker

FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build /out/worker/node_modules ./node_modules
COPY --from=build /out/worker/dist ./dist
COPY --from=build /out/worker/package.json ./package.json
USER node
CMD ["node", "dist/main.js"]
