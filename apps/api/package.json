{
  "name": "@lifepilot/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "start": "node dist/server.js",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "seed": "tsx src/scripts/seed.ts"
  },
  "dependencies": {
    "@lifepilot/core": "workspace:*",
    "@lifepilot/db": "workspace:*",
    "@lifepilot/jobs": "workspace:*",
    "@lifepilot/shared": "workspace:*",
    "@node-rs/argon2": "^2.2.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "0.45.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "luxon": "^3.7.2",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.15.0",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.3.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^5.0.5"
  }
}
