    "bullmq": "6.5.1",
    "drizzle-orm": "0.45.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^5.0.5"
  }
}
